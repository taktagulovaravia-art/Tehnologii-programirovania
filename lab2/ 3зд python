number = int(input("Введите пятизначное число: "))

a = number // 10000
b = number // 1000 % 10
c = number // 100 % 10
d = number // 10 % 10
e = number % 10

sum_digits = a + b + c + d + e
reverse_number = e * 10000 + d * 1000 + c * 100 + b * 10 + a

print("Сумма цифр:", sum_digits)
print("Число в обратном порядке:", reverse_number)
