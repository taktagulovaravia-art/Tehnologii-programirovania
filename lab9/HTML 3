<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Дашборд задач</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f2f4f8;
            padding: 20px;
        }

        h1 {
            text-align: center;
        }

        .dashboard {
            max-width: 800px;
            margin: auto;
        }

        .stats {
            display: flex;
            gap: 15px;
            margin: 20px 0;
        }

        .card {
            flex: 1;
            padding: 20px;
            background: white;
            border-radius: 10px;
            text-align: center;
        }

        .card h2 {
            font-size: 28px;
        }

        select, button {
            padding: 10px;
            margin: 5px;
        }

        ul {
            padding: 0;
            list-style: none;
        }

        li {
            background: white;
            margin: 8px 0;
            padding: 12px;
            border-radius: 8px;
        }

        .completed {
            color: green;
        }

        .pending {
            color: red;
        }
    </style>
</head>

<body>

<div class="dashboard">

    <h1>Дашборд задач</h1>

    <div class="stats">

        <div class="card">
            <h3>Выполнено</h3>
            <h2 id="completed">0</h2>
        </div>

        <div class="card">
            <h3>Не выполнено</h3>
            <h2 id="pending">0</h2>
        </div>

        <div class="card">
            <h3>Всего задач</h3>
            <h2 id="total">0</h2>
        </div>

    </div>

    <label for="userFilter">Фильтр по userId:</label>

    <select id="userFilter">
        <option value="all">Все пользователи</option>
    </select>

    <button onclick="loadTodos()">Обновить</button>

    <ul id="todoList"></ul>

</div>

<script>
    let todos = [];

    async function loadTodos() {
        try {
            const response = await fetch(
                "https://jsonplaceholder.typicode.com/todos"
            );

            todos = await response.json();

            const userFilter = document.getElementById("userFilter");

            userFilter.innerHTML =
                '<option value="all">Все пользователи</option>';

            for (let userId = 1; userId <= 10; userId++) {
                userFilter.innerHTML +=
                    `<option value="${userId}">Пользователь ${userId}</option>`;
            }

            userFilter.onchange = filterTodos;

            filterTodos();

        } catch (error) {
            console.error("Ошибка загрузки:", error);
        }
    }

    function filterTodos() {
        const userId = document.getElementById("userFilter").value;

        let filteredTodos = todos;

        if (userId !== "all") {
            filteredTodos = todos.filter(
                todo => todo.userId === Number(userId)
            );
        }

        displayTodos(filteredTodos);
    }

    function displayTodos(filteredTodos) {
        const completed = filteredTodos.filter(
            todo => todo.completed
        ).length;

        const pending = filteredTodos.filter(
            todo => !todo.completed
        ).length;

        document.getElementById("completed").textContent = completed;

        document.getElementById("pending").textContent = pending;

        document.getElementById("total").textContent =
            filteredTodos.length;

        const todoList = document.getElementById("todoList");

        todoList.innerHTML = "";

        filteredTodos.forEach(todo => {
            const li = document.createElement("li");

            li.innerHTML = `
                <strong>ID:</strong> ${todo.id}<br>
                <strong>Пользователь:</strong> ${todo.userId}<br>
                <strong>Задача:</strong> ${todo.title}<br>
                <strong>Статус:</strong>
                <span class="${todo.completed ? 'completed' : 'pending'}">
                    ${todo.completed ? 'Выполнено' : 'Не выполнено'}
                </span>
            `;

            todoList.appendChild(li);
        });
    }

    loadTodos();
</script>

</body>
</html>
