class Student:
    def __init__(self, name, age, specialty):
        self.name = name
        self.age = age
        self.specialty = specialty

    def show_info(self):
        print("Имя:", self.name)
        print("Возраст:", self.age)
        print("Специальность:", self.specialty)

    def change_specialty(self, new_specialty):
        self.specialty = new_specialty


# Создание объекта
student = Student("Равия", 19, "Информационные технологии")

# Вывод информации
student.show_info()

# Изменение специальности
student.change_specialty("Информационные системы")

print("\nПосле изменения специальности:")
student.show_info()
