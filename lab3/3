class Product:
    def __init__(self, name, price, quantity):
        self.name = name
        self.price = price
        self.quantity = quantity

    def total_price(self):
        return self.price * self.quantity


class Order:
    def __init__(self):
        self.products = []

    def add_product(self, product):
        self.products.append(product)

    def total_cost(self):
        total = 0

        for product in self.products:
            total += product.total_price()

        return total

    def show_order(self):
        print("Товары в заказе:")
        for product in self.products:
            print(
                product.name,
                "-", product.quantity,
                "шт. x", product.price,
                "=", product.total_price()
            )


# Создание товаров
product1 = Product("Ноутбук", 300000, 1)
product2 = Product("Мышь", 5000, 2)
product3 = Product("Клавиатура", 15000, 1)

# Создание заказа
order = Order()

# Добавление товаров
order.add_product(product1)
order.add_product(product2)
order.add_product(product3)

# Вывод заказа
order.show_order()

# Общая стоимость
print("Общая стоимость заказа:", order.total_cost(), "тг.")


