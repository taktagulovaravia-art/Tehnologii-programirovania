<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Список покупок</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            padding: 30px;
        }

        input {
            padding: 10px;
            width: 250px;
        }

        button {
            padding: 10px 15px;
            cursor: pointer;
        }

        li {
            margin: 10px 0;
            cursor: pointer;
        }

        /* Выполненный товар */
        .done {
            text-decoration: line-through;
            color: gray;
        }
    </style>
</head>

<body>

    <h1>Мой список покупок</h1>

    <input id="productInput" type="text" placeholder="Например: молоко">
    <button onclick="addProduct()">Добавить</button>

    <ul id="shoppingList">
    </ul>

    <script>
        // Функция добавления товара
        function addProduct() {

            // Получаем текст из поля
            let input = document.getElementById("productInput");
            let product = input.value;

            // Если поле пустое, ничего не добавляем
            if (product === "") {
                return;
            }

            // Создаём новый пункт списка
            let item = document.createElement("li");

            // Записываем название товара
            item.textContent = product;

            // При клике отмечаем товар выполненным
            item.onclick = function() {
                item.classList.toggle("done");
            };

            // Добавляем товар в список
            document.getElementById("shoppingList").appendChild(item);

            // Очищаем поле ввода
            input.value = "";
        }
    </script>

</body>
</html>
