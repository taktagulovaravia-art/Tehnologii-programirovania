<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Мастер регистрации</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f2f2f2;
            padding: 30px;
        }

        .container {
            max-width: 500px;
            margin: auto;
            background: white;
            padding: 25px;
            border-radius: 10px;
        }

        .block {
            display: none;
        }

        .block.active {
            display: block;
        }

        input, select {
            width: 100%;
            padding: 10px;
            margin: 8px 0 15px;
            box-sizing: border-box;
        }

        button {
            padding: 10px 20px;
            margin-right: 10px;
            cursor: pointer;
        }

        .error {
            color: red;
        }

        #summary {
            display: none;
            margin-top: 20px;
            padding: 15px;
            background-color: #e8f5e9;
        }
    </style>
</head>

<body>

<div class="container">

    <h2>Регистрация</h2>

    <!-- Блок 1 -->
    <div id="block1" class="block active">
        <h3>1. Личные данные</h3>

        <label>Имя:</label>
        <input type="text" id="name">

        <label>Фамилия:</label>
        <input type="text" id="surname">

        <label>Возраст:</label>
        <input type="number" id="age">

        <p id="error1" class="error"></p>

        <button onclick="nextBlock()">Далее</button>
    </div>

    <!-- Блок 2 -->
    <div id="block2" class="block">
        <h3>2. Параметры аккаунта</h3>

        <label>Email:</label>
        <input type="email" id="email">

        <label>Пароль:</label>
        <input type="password" id="password">

        <label>Тип аккаунта:</label>
        <select id="account">
            <option value="">Выберите тип</option>
            <option value="Обычный">Обычный</option>
            <option value="Премиум">Премиум</option>
        </select>

        <p id="error2" class="error"></p>

        <button onclick="backBlock()">Назад</button>
        <button onclick="finish()">Завершить</button>
    </div>

    <!-- Итог -->
    <div id="summary">
        <h3>Регистрация завершена</h3>

        <p><strong>Имя:</strong> <span id="resultName"></span></p>
        <p><strong>Фамилия:</strong> <span id="resultSurname"></span></p>
        <p><strong>Возраст:</strong> <span id="resultAge"></span></p>
        <p><strong>Email:</strong> <span id="resultEmail"></span></p>
        <p><strong>Тип аккаунта:</strong> <span id="resultAccount"></span></p>
    </div>

</div>

<script>
    // Проверка первого блока
    function nextBlock() {
        const name = document.getElementById("name").value.trim();
        const surname = document.getElementById("surname").value.trim();
        const age = Number(document.getElementById("age").value);
        const error = document.getElementById("error1");

        if (name === "" || surname === "" || age <= 0) {
            error.textContent = "Заполните все поля корректно.";
            return;
        }

        error.textContent = "";

        document.getElementById("block1").classList.remove("active");
        document.getElementById("block2").classList.add("active");
    }

    // Возврат к первому блоку
    function backBlock() {
        document.getElementById("block2").classList.remove("active");
        document.getElementById("block1").classList.add("active");
    }

    // Проверка второго блока и вывод результата
    function finish() {
        const email = document.getElementById("email").value.trim();
        const password = document.getElementById("password").value;
        const account = document.getElementById("account").value;
        const error = document.getElementById("error2");

        if (email === "" || password.length < 6 || account === "") {
            error.textContent =
                "Заполните все поля. Пароль должен содержать минимум 6 символов.";
            return;
        }

        error.textContent = "";

        // Вывод данных
        document.getElementById("resultName").textContent =
            document.getElementById("name").value;

        document.getElementById("resultSurname").textContent =
            document.getElementById("surname").value;

        document.getElementById("resultAge").textContent =
            document.getElementById("age").value;

        document.getElementById("resultEmail").textContent = email;

        document.getElementById("resultAccount").textContent = account;

        // Скрываем форму и показываем резюме
        document.getElementById("block2").classList.remove("active");
        document.getElementById("summary").style.display = "block";
    }
</script>

</body>
</html>
