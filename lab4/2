<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Расчёт доставки</title>
</head>
<body>

    <h2>Форма расчёта доставки</h2>

    <form id="deliveryForm">

        <label for="city">Город:</label><br>
        <select id="city" required>
            <option value="">Выберите город</option>
            <option value="Алматы">Алматы</option>
            <option value="Астана">Астана</option>
            <option value="Шымкент">Шымкент</option>
            <option value="Караганда">Караганда</option>
        </select>

        <br><br>

        <label for="weight">Вес посылки (кг):</label><br>
        <input type="number" id="weight" min="0.01" step="0.01" required>

        <br><br>

        <label for="delivery">Тип доставки:</label><br>
        <select id="delivery" required>
            <option value="">Выберите тип доставки</option>
            <option value="Обычная">Обычная</option>
            <option value="Экспресс">Экспресс</option>
        </select>

        <br><br>

        <button type="submit">Рассчитать</button>
    </form>

    <div id="result"></div>

    <script>
        document.getElementById("deliveryForm").addEventListener("submit", function(event) {
            event.preventDefault();

            const city = document.getElementById("city").value;
            const weight = Number(document.getElementById("weight").value);
            const delivery = document.getElementById("delivery").value;
            const result = document.getElementById("result");

            if (weight <= 0) {
                result.innerHTML = "<p style='color: red;'>Ошибка: вес должен быть положительным!</p>";
                return;
            }

            result.innerHTML = `
                <h3>Данные доставки:</h3>
                <p>Город: ${city}</p>
                <p>Вес посылки: ${weight} кг</p>
                <p>Тип доставки: ${delivery}</p>
            `;
        });
    </script>

</body>
</html>
